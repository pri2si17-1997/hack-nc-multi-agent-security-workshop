          "queryType": "range",
          "legendFormat": "{{writer}}",
          "expr": "sum by (writer) (count_over_time({service_name=\"audit-service\"} | decision=\"deny\" [$__range]))"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "justifyMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
