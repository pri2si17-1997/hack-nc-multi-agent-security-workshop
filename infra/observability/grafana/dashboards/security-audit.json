          "noValue": "0",
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "dark-red"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Break-the-glass",
      "description": "Emergency access grants. Allowed, but reviewed afterwards.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
