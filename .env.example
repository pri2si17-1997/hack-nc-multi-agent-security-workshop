# Copy to .env (make env does this for you). All values are DEMO values.

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Issuer as it appears inside tokens (what validators expect in `iss`).
KEYCLOAK_ISSUER=http://localhost:8080/realms/hacknc-hospital
# Where code actually sends HTTP requests. From the Mac: localhost.
# Inside containers (later phases) this becomes http://keycloak:8080/realms/hacknc-hospital
KEYCLOAK_URL=http://localhost:8080/realms/hacknc-hospital

# Demo users all share this password (see infra/keycloak/realm-hacknc-hospital.json).
DEMO_USER_PASSWORD=hacknc

# Client secrets: demo values, committed on purpose. Never do this for real systems.
ORCHESTRATOR_CLIENT_SECRET=orchestrator-demo-secret
MEDREC_AGENT_CLIENT_SECRET=medrec-agent-demo-secret
SUMMARY_AGENT_CLIENT_SECRET=summary-agent-demo-secret
PRESCRIPTION_AGENT_CLIENT_SECRET=prescription-agent-demo-secret
BENEFITS_AGENT_CLIENT_SECRET=benefits-agent-demo-secret
SCHEDULING_AGENT_CLIENT_SECRET=scheduling-agent-demo-secret
TRANSITIONS_AGENT_CLIENT_SECRET=transitions-agent-demo-secret
INSTRUCTIONS_AGENT_CLIENT_SECRET=instructions-agent-demo-secret
CHART_AGENT_CLIENT_SECRET=chart-agent-demo-secret
PORTAL_AGENT_CLIENT_SECRET=portal-agent-demo-secret
EHR_MCP_CLIENT_SECRET=ehr-mcp-demo-secret
DISCLOSURE_MCP_CLIENT_SECRET=disclosure-mcp-demo-secret
HOSPITAL_UI_CLIENT_SECRET=hospital-ui-demo-secret
APPROVAL_SERVICE_CLIENT_SECRET=approval-service-demo-secret

# --- Hospital UI ------------------------------------------------------------
UI_BASE_URL=http://localhost:8000
# Signs the UI's session cookie. Any long random string.
UI_SESSION_SECRET=hacknc-demo-session-secret-change-me

# --- Human-in-the-loop (approval service) -----------------------------------
# How long a request waits for a physician, and how long an approval stays usable.
APPROVAL_TTL_SECONDS=3600
BREAK_GLASS_TTL_SECONDS=900
# Lets the admin console change demo switches (agents, partners, scenarios).
DEMO_ADMIN_KEY=hacknc-demo-admin-key

# --- Audit ------------------------------------------------------------------
# Shared secret OPA uses to upload decision logs (see infra/opa/config.yaml for why).
OPA_LOG_TOKEN=hacknc-demo-opa-log-token

# --- Language model (summary, instructions and chart agents; Strands Agents) ------
# Tried in order: LLM_PROVIDER, then LLM_FALLBACK; deterministic rules are always last.
LLM_PROVIDER=bedrock
LLM_FALLBACK=ollama
LLM_TIMEOUT_SECONDS=30
# Reasoning models (gpt-oss) spend part of the output limit thinking.
LLM_MAX_TOKENS=4000
LLM_REASONING_EFFORT=low
# Leave empty for models that reject it ("temperature ... deprecated"), e.g. newer Claude.
LLM_TEMPERATURE=0.2
# ~/.aws is mounted read-only into those three agents. Run `aws login` (or SSO) before `make up`.
AWS_PROFILE=default
# Empty: the profile's region (us-east-1 if it has none).
AWS_REGION=
# Newer Claude models need an inference profile id, e.g. us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=openai.gpt-oss-20b-1:0
# Empty -> public regional endpoint. VPC interface endpoint (PrivateLink), e.g.
#   https://vpce-xxxxxxxx.bedrock-runtime.us-east-1.vpce.amazonaws.com
BEDROCK_ENDPOINT_URL=
# Ollama runs natively on the Mac (Metal); containers reach it via host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Observability ----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Send spans every 0.2 s (default 5 s) so the UI's "Under the hood" panel feels live.
OTEL_BSP_SCHEDULE_DELAY=200
# Strands: redact prompts, answers and tool payloads in spans (they contain PHI).
# An empty allow-list after "=" means: redact everything.
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_unredacted_attributes=
